# Runtime mode
# DEMO_MODE=true enables deterministic seeded records without Supabase
DEMO_MODE=true

# Supabase (required only when DEMO_MODE=false)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Server
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Vision Service URL used by external clients
VISION_SERVICE_URL=http://localhost:8000
